# GitHub personal access token, read-only scopes (public_repo or no scopes for public data)
GITHUB_TOKEN=

# SQLite database file defaults to <repo root>/data/insights.db — no need to set DB_PATH
# unless you want to override that location.

# How long (seconds) cached GitHub data is considered fresh before re-fetching
CACHE_TTL_SECONDS=900

# Timeout (seconds) for the `claude` CLI subprocess used by the narrative endpoint
CLAUDE_CLI_TIMEOUT_SECONDS=60
